# Supabase Configuration
# Get these values from your Supabase project Settings → API

# Project ID (found in Settings → General)
SUPABASE_PROJECT_ID=your_project_id

# Public/Anon Key (found in Settings → API → Project API keys)
# This is safe to expose to the client
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# API URL (found in Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Secret Key (found in Settings → API → Project API keys)
# ⚠️  SECURITY: This bypasses RLS! Never commit or expose to client!
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

# Client-side variables (prefixed with VITE_)
# These are bundled into the browser and must be public
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
